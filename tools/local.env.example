# Copy to tools/local.env (git-ignored) and fill in. tools/build-all.sh reads it first; values already set in the
# environment win only if you write them as VAR="${VAR:-value}".
GAME_APP="$HOME/path/to/Cyberpunk2077.app"          # Steam Mac 2.5.0 (the build the baked hooks are for)
#SIGN_ID="<codesign identity SHA-1 or name>"         # empty: unsigned IPA for a sideloader, plugins ad-hoc signed
#PROFILE="$HOME/path/to/profile.mobileprovision"
#BUNDLE_ID="com.example.cyport"
#CYPORT_DEVICE="<devicectl device id>"               # only for --install
#PLUGINS_ROOT="$HOME/path/to/CyPort-red4ext"          # default: CyPort-red4ext next to this repo
#MAC_HASHES="$HOME/path/to/.cyport-mac-hashes.bin"    # optional: imported archives are checked against the game
